PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/aeon_markflow
JWT_SECRET=replace-with-shared-secret-from-aeon-onboard

# Base URL used to build click-tracking redirect links (GET {TRACKING_BASE_URL}/r/:token).
TRACKING_BASE_URL=http://localhost:4000

# Deployment-level map of sending domain -> { provider, mailbox }, as a JSON object, e.g.:
# {"aeonsynergies.com":{"provider":"microsoft_graph","mailbox":"info@aeonsynergies.com"},
#  "mail.aeonsynergies.com":{"provider":"microsoft_graph","mailbox":"sales@mail.aeonsynergies.com"},
#  "aeonmiles.com":{"provider":"google_workspace","mailbox":"sales@aeonmiles.com"}}
# This is separate from an Organization's own sending_domains[] — that list says which domains an
# org may send from *and for which purpose* ({ domain, purpose: "marketing" | "transactional" |
# "alerts" }[]; DomainRouter's resolveSendingRoute/routableDomainsForOrg select by purpose, not
# just by domain); this map says which provider account actually owns each domain. Known mapping
# for the Aeon Synergies domains (DKIM confirmed on both): aeonsynergies.com is transactional,
# mail.aeonsynergies.com is marketing — never point a marketing send at the bare domain or vice
# versa.
DOMAIN_PROVIDER_MAP_JSON=

# Microsoft 365 (app-only Graph: Mail.Send / Mail.Read). Requires admin consent on those
# application permissions — missing consent fails at request time, not at startup.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# MarkFlow's own internal notifications (ReviewTask alerts, SendGuardrail pause notices) — always
# sent via the microsoft_graph provider above, as a shared M365 mailbox. Confirm this mailbox
# exists and the app registration has Mail.Send access to it (ops task) before relying on this;
# a missing/unconfigured mailbox only logs an error, it never blocks the ReviewTask/pause itself.
# INTERNAL_NOTIFICATIONS_RECIPIENTS is optional and defaults to the mailbox itself (a shared
# inbox a team monitors together); set it to route alerts to specific addresses instead.
INTERNAL_NOTIFICATIONS_MAILBOX=notifications@aeonsynergies.com
INTERNAL_NOTIFICATIONS_RECIPIENTS=

# Google Workspace domain-wide delegation. The full service-account key JSON, as one line.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Zoho Mail — Self Client OAuth registration (not the Server-based one).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://mail.zoho.com

# AI template assistant (Phase 3). The Anthropic SDK also accepts an `ant auth login` profile
# in place of this key — see the SDK docs if you'd rather not manage a raw key locally.
ANTHROPIC_API_KEY=

# Workflow builder + enrollment engine (Phase 4). BullMQ queue/worker connection.
REDIS_URL=redis://localhost:6379
